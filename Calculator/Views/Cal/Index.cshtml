<div class="container my-5">
    <div class="col-md-4 mx-auto">

        <div class="card shadow p-4">

            <h3 class="text-center mb-4">Calculator</h3>

            <form method="post">

                <input type="text" name="display" placeholder="0" value="@ViewBag.Display" class="form-control text-end fs-3 mb-3" readonly />

                <div class="row g-2">
                    <div class="col-3"><button class="btn btn-outline-secondary w-100" type="submit" name="button" value="7"> 7 </button></div>
                    <div class="col-3"><button class="btn btn-outline-secondary w-100" type="submit" name="button" value="8"> 8 </button></div>
                    <div class="col-3"><button class="btn btn-outline-secondary w-100" type="submit" name="button" value="9"> 9 </button></div>
                    <div class="col-3"><button class="btn btn-outline-secondary w-100" type="submit" name="button" value="/"> / </button></div>

                    <div class="col-3"><button class="btn btn-outline-secondary w-100" type="submit" name="button" value="4"> 4 </button></div>
                    <div class="col-3"><button class="btn btn-outline-secondary w-100" type="submit" name="button" value="5"> 5 </button></div>
                    <div class="col-3"><button class="btn btn-outline-secondary w-100" type="submit" name="button" value="6"> 6 </button></div>
                    <div class="col-3"><button class="btn btn-outline-secondary w-100" type="submit" name="button" value="*"> * </button></div>

                    <div class="col-3"><button class="btn btn-outline-secondary w-100" type="submit" name="button" value="1"> 1 </button></div>
                    <div class="col-3"><button class="btn btn-outline-secondary w-100" type="submit" name="button" value="2"> 2 </button></div>
                    <div class="col-3"><button class="btn btn-outline-secondary w-100" type="submit" name="button" value="3"> 3 </button></div>
                    <div class="col-3"><button class="btn btn-outline-secondary w-100" type="submit" name="button" value="-"> - </button></div>

                    <div class="col-3"><button class="btn btn-outline-secondary w-100" type="submit" name="button" value="0"> 0 </button></div>
                    <div class="col-3"><button class="btn btn-outline-secondary w-100" type="submit" name="button" value="C"> C </button></div>
                    <div class="col-3"><button class="btn btn-outline-secondary w-100" type="submit" name="button" value="AC"> AC </button></div>
                    <div class="col-3"><button class="btn btn-outline-secondary w-100" type="submit" name="button" value="+"> + </button></div>

                    <div class="col-3"><button class="btn btn-outline-secondary w-100" type="submit" name="button" value="."> . </button></div>
                    <div class="col-3"><button class="btn btn-outline-secondary w-100" type="submit" name="button" value="("> ( </button></div>
                    <div class="col-3"><button class="btn btn-outline-secondary w-100" type="submit" name="button" value=")"> ) </button></div>

                    <div class="col-12 d-flex justify-content-center">
                        <button class="btn btn-success w-25" type="submit" name="button"value="="> = </button>
                    </div>

                </div>

            </form>

        </div>

                @if (ViewBag.Result != null)
                {
                    <div class="card-footer text-center bg-light mt-3">
                        <h4>Result: <span class="text-primary">@ViewBag.Result</span></h4>
                    </div>
                }

    </div>
</div>





